# Gemini API keys, comma separated (the next key is tried on 429)
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash

# Server (0.0.0.0 so the iPhone on the same wifi can open /phone)
SMARTPOST_HOST=0.0.0.0
SMARTPOST_PORT=8500

# How many jobs run each stage at the same time
SMARTPOST_FETCH_PARALLEL=2
SMARTPOST_PLAN_PARALLEL=3
SMARTPOST_RENDER_PARALLEL=2

# Optional: extra yt-dlp args, e.g. --cookies-from-browser chrome
SMARTPOST_YTDLP_ARGS=
